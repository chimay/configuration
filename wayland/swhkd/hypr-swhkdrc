# vim: set filetype=conf:

# documentation {{{1

#
# wm independent hotkeys
#

# Noms des touches : voir la page
#     man swhkd
# et la sortie de
#     wev -event keyboard | grep keysym

# Mouse
# button1,2,3 = gauche, milieu, droit
# button4,5 = molette haut/bas
# button6,7 = molette gauche/droite
# button8,9 = latéraux gauche/droit

# applications {{{1

super + ctrl + a
	hypr-run-favorites.zsh &> ~/log/hypr-run-favorites.zsh

super + ctrl + equal
	kitty --single-instance --name calc calc

super + ctrl + f
	thunar || caja || pcmanfm

super + ctrl + n
	run-neovim-server.sh & ; sleep 2 ; run-neovim-qt-client.sh

#super + ctrl + n
#	run-neovim-qt-client.sh

super + shift + n
	neovim-qt-lite.sh

super + ctrl + g
	run-gvim.sh

super + shift + g
	gvim-lite.sh

super + ctrl + e
	run-emacs-server.sh

super + shift + e
	run-emacs-client.sh

super + ctrl + i
	gwenview ~

super + shift + i
	vimiv ~/photo/numerique

super + ctrl + q
	goto-or-run.sh qutebrowser

super + ctrl + {b,w,z}
	goto-or-run-appimage.sh {floorp,vieb,zen-browser}

super + shift + o
	torbrowser-launcher

super + ctrl + k
	keepassxc

super + ctrl + o
	octave --gui

super + ctrl + t
	tradingview

super + ctrl + y
	run-freetube.sh

# mnemo : multimedia
super + ctrl + m
	vlc

# notifications {{{1

super + F11
	dunstctl history-pop

super + F12
	dunstctl close-all

