# multimédia {{{1

XF86AudioRaiseVolume
	pamixer --increase 5

XF86AudioLowerVolume
	pamixer --decrease 5

XF86AudioMute
	pamixer --toggle-mute

XF86AudioPlay
	mpc toggle
