
layout {
	cwd "~/racine"
	default_tab_template {
		pane size=1 borderless=true {
			plugin location="compact-bar"
		}
		children
	}
	pane_template name="zsh" {
		cwd "~/racine"
		command "zsh"
		args "-l" "-i"
		start_suspended false
	}
	tab name="1 shell" {
		zsh
	}
	tab name="2 sand" {
		zsh
	}
	tab name="3 wave" {
		zsh
	}
	tab name="4 beach" {
		zsh
	}
	// avoid auto cd from zsh at login
	tab name="5 repo" {
		pane stacked=true {
			pane {
				expanded true
				cwd "~/racine/public/eclats2vers/generic"
				command "zsh"
				start_suspended false
			}
			pane {
				cwd "~/racine/public/eclats2vers/generic/matemat"
				command "zsh"
				start_suspended false
			}
			pane {
				cwd "~/racine/public/eclats2vers/generic/matemat/tikz"
				command "zsh"
				start_suspended false
			}
		}
	}
	tab name="6 mail" {
		pane {
			command "run-neomutt.zsh"
			start_suspended true
			close_on_exit false
		}
	}
	tab name="7 fedi" {
		pane {
			command "zsh"
			//command "weechat"
			start_suspended false
			close_on_exit false
		}
	}
	tab name="8 music" {
		pane {
			command "ncmpcpp"
			//command "rmpc"
			start_suspended true
			close_on_exit false
		}
	}
	tab name="9 monitor" {
		pane {
			command "btop"
			start_suspended true
			close_on_exit false
		}
	}
}
