
layout {
	cwd "~/racine"
	default_tab_template {
		pane size=1 borderless=true {
			plugin location="status-bar"
		}
		children
		pane size=1 borderless=true {
			plugin location="tab-bar"
		}
	}
	pane_template name="zsh" {
		cwd "~/racine"
		command "zsh"
		args "-l" "-i"
		start_suspended false
	}
	tab name="1 shell" {
		zsh
	}
	tab name="2 sand" {
		zsh
	}
	tab name="3 wave" {
		zsh
	}
	tab name="4 beach" {
		zsh
	}
}
