
# operating system {{{1

case $(uname -a) in

	*Linux*ARCH*)
		OPERASYS=archlinux
		;;
	*FreeBSD*)
		OPERASYS=freebsd
		;;
	*Linux*|*linux*)
		OPERASYS=linux
		;;
	?*)
		OPERASYS=inconnu
		;;
esac

export OPERASYS

# user settings {{{1

source ${HOME}/racine/config/cmdline/zsh/zshrc

autoload -U colors && colors

# options {{{1

#setopt noautocd noautomenu nohup nocheckjobs
setopt nohup nocheckjobs

setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_find_no_dups

# history {{{1

HISTFILE=${HOME}/racine/hist/zsh/$HOST-run-term
SAVEHIST=84127
HISTSIZE=$SAVEHIST

# functions {{{1

# mb_quit {{{2

function mb_quit {
    exit
}

zle -N mb_quit

bindkey "^G" mb_quit

# precmd {{{2

typeset -ga precmd_functions

precmd_functions=()

function precmd {
	# ---- prompt
	prompt off
	PROMPT='
%F{red} cmd %! > %f'
	#RPROMPT='%F{yellow}%D{(o) %H:%M [=] %a %d %b %Y}'
}

