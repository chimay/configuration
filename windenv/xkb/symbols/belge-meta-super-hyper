// vim: set filetype=xkb sw=4 ts=4 sts=4 et :

// opening {{{1

default partial alphanumeric_keys modifier_keys

xkb_symbols "basic" {

// include {{{1

    // Base layout

    include "be(basic)"

    name[Group1] = "Belgian (meta super hyper)";

// modifiers {{{1

    replace modifier_map Shift   { <LFSH>, <RTSH> };
    replace modifier_map Control { <LCTL>, <RCTL> };
    replace modifier_map Lock    { <CAPS> };
    replace modifier_map Mod1    { <LALT> };
    replace modifier_map Mod2    { <NMLK> };
    replace modifier_map Mod4    { <LWIN> };
    replace modifier_map Mod3    { <MENU> };
    replace modifier_map Mod5    { <RALT> };

// keys {{{2

    replace key <CAPS> {
        [ Escape ]
    };

    replace key <ESC> {
        [ Caps_Lock ]
    };

    // Remove the inherited Lock modifier from Caps.
    modifier_map None { <CAPS> };

    replace key <LFSH> {
        [ Shift_L ]
    };

    replace key <RTSH> {
        [ Shift_R ]
    };

    replace key <LCTL> {
        [ Control_L ]
    };

    replace key <RCTL> {
        [ Control_R ]
    };

    replace key <LALT> {
        [ Alt_L, Meta_L ]
    };

    replace key <LWIN> {
        [ Super_L ]
    };

    replace key <MENU> {
        [ Hyper_R ]
    };

    // keycode 108
    //
    // This is the XKB equivalent of:
    //     keycode 108 = ISO_Level3_Shift ...
    //
    // TWO_LEVEL is intentional: pressing RAlt itself must produce
    // the modifier keysym, rather than trying to use it as a
    // normal four-level key.
    replace key <RALT> {
        type[Group1] = "ONE_LEVEL",
        [ ISO_Level3_Shift ]
    };

// left from numbers row {{{1

    // 2 and 3 superior
    replace key <TLDE> {
        [ asciitilde, grave ]
    };

// print screen, scroll lock, pause break {{{1

    replace key <PRSC> {
        type[Group1] = "TWO_LEVEL",
            [ bracketleft, braceleft ]
    };

    replace key <SCLK> {
        type[Group1] = "TWO_LEVEL",
            [ bracketright, braceright ]
    };

    replace key <PAUS> {
        type[Group1] = "TWO_LEVEL",
            [ rightsinglequotemark, at ]
    };

// numbers {{{1

    // keycode 13 = AE04
    //
    // Xmodmap:
    //
    //   apostrophe  4  apostrophe  4
    //   rightsinglequotemark dollar onequarter
    //
    // Effective:
    //
    //   normal       apostrophe
    //   Shift        4
    //   AltGr        rightsinglequotemark
    //   Shift+AltGr  dollar
    //
    // The 7th/8th entries of the original Xmodmap are not used by
    // normal X servers.
    replace key <AE04> {
        type[Group1] = "FOUR_LEVEL",
        [ apostrophe, 4, rightsinglequotemark, dollar ]
    };

    replace key <AE06> {
        type[Group1] = "FOUR_LEVEL",
        [ section, 6, dead_circumflex, fiveeighths ]
    };

    replace key <AE12> {
        type[Group1] = "FOUR_LEVEL",
        [ minus, underscore, parenright, dead_ogonek ]
    };

// letters {{{1

    // Effective AltGr levels:
    //     AltGr       Multi_key
    //     Shift+AltGr copyright
    replace key <AB03> {
        type[Group1] = "FOUR_LEVEL",
        [ c, C, Multi_key, copyright ]
    };

// right of letters {{{1

    replace key <AD11> {
        type[Group1] = "FOUR_LEVEL",
        [ asciicircum, dead_diaeresis, bracketleft, dead_abovering ]
    };

    replace key <AB10> {
        type[Group1] = "FOUR_LEVEL",
        [ equal, plus, asciitilde, dead_abovedot ]
    };

// numeric keypad {{{1

//     replace key <KPAD> {
//         [ plus ]
//     };

};
