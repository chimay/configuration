# Liste de lecture {{{1

def_key "é"
 apply_filter

def_key "è" [deferred]
  require_runnable "apply_filter"
  push_character "ctrl-w"
  push_character "enter"
  apply_filter

def_command "cl" [deferred]
  require_runnable "apply_filter"
  push_character "ctrl-w"
  push_characters "classique"
  push_character "enter"
  apply_filter

def_command "jz" [deferred]
  require_runnable "apply_filter"
  push_character "ctrl-w"
  push_characters "jazz"
  push_character "enter"
  apply_filter

def_command "ch" [deferred]
  require_runnable "apply_filter"
  push_character "ctrl-w"
  push_characters "chanson"
  push_character "enter"
  apply_filter

def_key "w"
 save_playlist

# Édition {{{1

def_key "t"
 save_tag_changes

# Quitter {{{1

def_key "q"
 quit

def_command "quit" [deferred]
  stop
  quit

def_command "q" [deferred]
  quit

