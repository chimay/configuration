font_family DejaVu Sans Mono
bold_font DejaVu Sans Mono Bold
italic_font DejaVu Sans Mono Oblique
bold_italic_font DejaVu Sans Bold Oblique
font_size 12.0
force_ltr no

adjust_line_height  0
adjust_column_width 0
adjust_baseline 0

symbol_map
font_features
box_drawing_scale 0.001, 1, 1.5, 2

cursor #5b3c11
cursor_text_color #000000
cursor_shape block
cursor_beam_thickness 1.5
cursor_underline_thickness 2.0
cursor_blink_interval 0
cursor_stop_blinking_after 15.0
scrollback_lines 2000
scrollback_pager less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER
scrollback_pager_history_size 0
scrollback_fill_enlarged_window no

wheel_scroll_multiplier 5.0
touch_scroll_multiplier 1.0
mouse_hide_wait 3.0
url_color #0087bd
url_style curly
open_url_with qutebrowser
url_prefixes http https file ftp gemini irc gopher mailto news git
detect_urls yes
url_excluded_characters
copy_on_select no
strip_trailing_spaces never
select_by_word_characters @-./_~?&=%+#
click_interval -1.0
focus_follows_mouse no
pointer_shape_when_grabbed arrow
default_pointer_shape beam
pointer_shape_when_dragging beam
clear_all_mouse_actions no
mouse_map left click ungrabbed mouse_handle_click selection link prompt
mouse_map shift+left click grabbed,ungrabbed mouse_handle_click selection link prompt
mouse_map ctrl+shift+left release grabbed,ungrabbed mouse_handle_click link
mouse_map ctrl+shift+left press grabbed discard_event
mouse_map middle release ungrabbed paste_from_selection
mouse_map left press ungrabbed mouse_selection normal
mouse_map ctrl+alt+left press ungrabbed mouse_selection rectangle
mouse_map left doublepress ungrabbed mouse_selection word
mouse_map left triplepress ungrabbed mouse_selection line
mouse_map ctrl+alt+left triplepress ungrabbed mouse_selection line_from_point
mouse_map right press ungrabbed mouse_selection extend
mouse_map shift+middle release ungrabbed,grabbed paste_selection
mouse_map shift+middle press grabbed discard_event
mouse_map shift+left press ungrabbed,grabbed mouse_selection normal
mouse_map ctrl+shift+alt+left press ungrabbed,grabbed mouse_selection rectangle
mouse_map shift+left doublepress ungrabbed,grabbed mouse_selection word
mouse_map shift+left triplepress ungrabbed,grabbed mouse_selection line
mouse_map ctrl+shift+alt+left triplepress ungrabbed,grabbed mouse_selection line_from_point
mouse_map shift+right press ungrabbed,grabbed mouse_selection extend
mouse_map ctrl+shift+right press ungrabbed mouse_show_command_output
repaint_delay 10
input_delay 3
sync_to_monitor yes
enable_audio_bell yes
visual_bell_duration 0.0
visual_bell_color none
window_alert_on_bell yes
bell_on_tab "🔔 "
command_on_bell none
bell_path none
remember_window_size  yes
initial_window_width  640
initial_window_height 400
enabled_layouts tall,fat,horizontal,vertical,grid,stack
window_resize_step_cells 2
window_resize_step_lines 2
draw_minimal_borders yes
window_margin_width 0
single_window_margin_width -1
window_padding_width 0
placement_strategy center
active_border_color #9b3c11
inactive_border_color #5b3c11
bell_border_color #ff5a00
inactive_text_alpha 1.0
hide_window_decorations no
window_logo_path none
window_logo_position bottom-right
window_logo_alpha 0.5
resize_debounce_time 0.1
resize_draw_strategy static
resize_in_steps no
visual_window_select_characters 1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ
confirm_os_window_close 0
tab_bar_edge bottom
tab_bar_margin_width 0.0
tab_bar_margin_height 0.0 0.0
tab_bar_style powerline
tab_bar_align right
tab_bar_min_tabs 2
tab_switch_strategy previous
tab_fade 0.25 0.5 0.75 1
tab_separator " ┇"
tab_powerline_style angled
tab_activity_symbol none
tab_title_template "{fmt.fg.red}{bell_symbol}{activity_symbol}{fmt.fg.default}{title}"
active_tab_title_template none
active_tab_foreground   #5b3c11
active_tab_background   #120705
active_tab_font_style   bold
inactive_tab_foreground #5b3c11
inactive_tab_background #000000
inactive_tab_font_style normal
tab_bar_background none
tab_bar_margin_color none
foreground #5b3c11
background #000000
background_opacity 1.0
background_image none
background_image_layout tiled
background_image_linear no
dynamic_background_opacity yes
background_tint 0.0
dim_opacity 0.75
selection_foreground #000000
selection_background #5b3c11
color0 #000000
color1 #b21818
color2 #118011
color3 #965724
color4 #1818b2
color5 #b218b2
color6 #149696
color7 #947454
color8 #434343
color9 #c74141
color10 #36a636
color11 #988404
color12 #5454ff
color13 #c842c8
color14 #309494
color15 #d75151
mark1_foreground black
mark1_background #88421d
mark2_foreground black
mark2_background #872e30
mark3_foreground black
mark3_background #5b3c11
shell zsh -l
editor vim
close_on_child_death no
allow_remote_control yes
listen_on none
env
watcher
exe_search_path
update_check_interval 0
startup_session none
clipboard_control write-clipboard write-primary read-clipboard-ask read-primary-ask
clipboard_max_size 64
file_transfer_confirmation_bypass
allow_hyperlinks yes
shell_integration enabled
term xterm-kitty
wayland_titlebar_color system
macos_titlebar_color system
macos_option_as_alt no
macos_hide_from_tasks no
macos_quit_when_last_window_closed no
macos_window_resizable yes
macos_thicken_font 0
macos_traditional_fullscreen no
macos_show_window_title_in all
macos_custom_beam_cursor no
linux_display_server auto
kitty_mod super
clear_all_shortcuts yes
map kitty_mod+c copy_to_clipboard
map ctrl+c copy_and_clear_or_interrupt
map kitty_mod+v paste_from_clipboard
map shift+insert paste_from_selection
map kitty_mod+p scroll_to_prompt -1
map kitty_mod+n scroll_to_prompt 1
map kitty_mod+ugrave show_scrollback
map kitty_mod+mu show_last_command_output
map kitty_mod+enter new_window
map cmd+enter       new_window
map kitty_mod+shift+enter new_os_window
map kitty_mod+] next_window
map kitty_mod+j next_window
map kitty_mod+w next_window
map kitty_mod+[ previous_window
map kitty_mod+k previous_window
map kitty_mod+shift+j move_window_forward
map kitty_mod+shift+k move_window_backward
map kitty_mod+` move_window_to_top
map kitty_mod+s start_resizing_window
map cmd+s       start_resizing_window
map kitty_mod+f focus_visible_window
map kitty_mod+agrave swap_with_window
map kitty_mod+section select_tab
map kitty_mod+l       next_tab
map kitty_mod+h      previous_tab
map kitty_mod+t new_tab
map cmd+t       new_tab
map kitty_mod+q close_tab
map kitty_mod+shift+l move_tab_forward
map kitty_mod+shift+h move_tab_backward
map kitty_mod+shift+t set_tab_title
map kitty_mod+g next_layout
map kitty_mod+plus    change_font_size all +1.0
map kitty_mod+minus   change_font_size all -1.0
map kitty_mod+kp_0    change_font_size all 0
map kitty_mod+u open_url_with_hints
map kitty_mod+space>f kitten hints --type path --program -
map kitty_mod+space>shift+f kitten hints --type path
map kitty_mod+space>l kitten hints --type line --program -
map kitty_mod+space>w kitten hints --type word --program -
map kitty_mod+space>h kitten hints --type hash --program -
map kitty_mod+space>n kitten hints --type linenum
map kitty_mod+space>y kitten hints --type hyperlink
action_alias launch_here launch --type=overlay --cwd=current
action_alias launch_tab launch --type=tab --cwd=current
map kitty_mod+dollar>k kitty_shell tab
map kitty_mod+dollar>e launch_tab elvish
map kitty_mod+dollar>f launch_tab fish -l
map kitty_mod+dollar>t launch_here tmux attach
map kitty_mod+dollar>x launch_tab xonsh -l
map kitty_mod+dollar>z launch_tab zsh -l
map kitty_mod+exclam>t launch_tab ssh taijitu.local
map kitty_mod+exclam>g launch_tab ssh galaxy.local
map kitty_mod+exclam>s launch_tab ssh shari.local
map kitty_mod+exclam>m launch_tab ssh mandala.local
map kitty_mod+exclam>u launch_tab ssh universe.local
map kitty_mod+exclam>x launch_tab ssh tixu.local
map kitty_mod+ampersand>e launch_tab emacs -nw -q -l ~/racine/config/edit/emacs/leger.el
map kitty_mod+ampersand>n launch_tab nvim
map kitty_mod+ampersand>v launch_tab vim
map kitty_mod+semicolon>c launch_tab clifm --no-color
map kitty_mod+semicolon>t launch_tab htop
map kitty_mod+semicolon>v launch_tab vifm
map kitty_mod+shift+f toggle_fullscreen
map kitty_mod+shift+m toggle_maximized
map opt+cmd+s toggle_macos_secure_keyboard_entry
map kitty_mod+shift+u    kitten unicode_input
map ctrl+cmd+space       kitten unicode_input
map kitty_mod+e	   edit_config_file
map super+o         set_background_opacity +0.1
map super+d         set_background_opacity -0.1
map kitty_mod+a>1 set_background_opacity 1
map kitty_mod+a>d set_background_opacity default
map kitty_mod+delete clear_terminal reset active
map opt+cmd+r        clear_terminal reset active
map kitty_mod+r    load_config_file
map kitty_mod+d debug_config
map opt+cmd+,   debug_config
